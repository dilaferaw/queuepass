APP_NAME=Queuepass
DEBUG=true
DATABASE_URL=postgresql+asyncpg://queuepass:queuepass@localhost:5432/queuepass

# JWT signing key. MUST be replaced before deploying anywhere real.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REDIS_REVOCATION_URL=redis://localhost:6379/0
REDIS_LOCKS_URL=redis://localhost:6379/1
REDIS_BROKER_URL=redis://localhost:6379/2
